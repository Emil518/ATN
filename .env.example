# Ne mets jamais les vraies valeurs dans ce fichier ni dans le ZIP.
# Ajoute-les dans les variables secrètes / variables d'environnement de Discloud.
DISCORD_TOKEN=colle_ici_le_token_du_bot
GEMINI_API_KEY=colle_ici_la_cle_api

# Facultatif
GEMINI_MODEL=gemini-2.0-flash
BOT_NAME=Assistant
BOT_LANGUAGE=français
MAX_HISTORY=12
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MINUTES=5